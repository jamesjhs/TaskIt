{
  "name": "taskit",
  "version": "1.22.5",
  "private": true,
  "description": "TaskIt! task management application",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "npm run security:xss-sinks && npm run build -w server",
    "build:css": "npm run build:css -w server",
    "start": "npm run start -w server",
    "dev": "npm run dev -w server",
    "dev:css": "npm run dev:css -w server",
    "security:xss-sinks": "node scripts/xss-sink-scan.js",
    "security:xss-sinks:update": "node scripts/xss-sink-scan.js --update"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "three": "0.128.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
