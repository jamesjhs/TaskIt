{
  "name": "taskit-server",
  "version": "1.22.5",
  "description": "TaskIt! task management server",
  "main": "dist/index.js",
  "scripts": {
    "build:css": "tailwindcss -i src/css/input.css -o ../public/tailwind.css --minify",
    "build": "npm run build:css && tsc",
    "start": "node dist/index.js",
    "dev:css": "tailwindcss -i src/css/input.css -o ../public/tailwind.css --watch",
    "dev": "tsx watch src/index.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
